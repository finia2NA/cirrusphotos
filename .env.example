# Copy this file to .env and replace each placeholder locally.
# Never commit .env or share its contents.
# Full base URL of the Synology NAS, including scheme and port.
NAS_URL=https://nas.example.com:5001
USER=your-synology-username
PW=your-synology-password
# Optional: omit or leave empty for accounts without two-factor authentication.
OTP=
