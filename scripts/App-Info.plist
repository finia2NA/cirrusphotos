<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>CirrusPhotos</string>
    <key>CFBundleIdentifier</key><string>de.richardhanss.cirrus-photos</string>
    <key>CFBundleName</key><string>Cirrus Photos</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIconName</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>NSHumanReadableCopyright</key><string>© 2026 Cirrus Photos contributors</string>
    <key>LSMinimumSystemVersion</key><string>27.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSLocalNetworkUsageDescription</key><string>Cirrus Photos connects to your Synology NAS on the local network.</string>
    <!-- Keeps info and debug messages of the app's subsystem on disk, so `log show` can
         reach the minutes before a crash. -->
    <key>OSLogPreferences</key><dict>
        <key>de.richardhanss.cirrus-photos</key><dict>
            <key>DEFAULT-OPTIONS</key><dict>
                <key>Level</key><dict>
                    <key>Enable</key><string>Debug</string>
                    <key>Persist</key><string>Debug</string>
                </dict>
            </dict>
        </dict>
    </dict>
    <!-- Development builds only: run.sh fills in the .env host; distribution builds remove it. -->
    <key>NSAppTransportSecurity</key><dict>
        <key>NSExceptionDomains</key><dict>
            <key>__NAS_HOST__</key><dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
            </dict>
        </dict>
    </dict>
</dict></plist>
